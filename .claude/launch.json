{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3010,http://localhost:3030&& npm run dev:api"
      ],
      "port": 3001
    },
    {
      "name": "painel",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set VITE_SITE_URL=http://localhost:5174&& npm run dev:painel"],
      "port": 3010
    },
    {
      "name": "checkout",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:checkout"],
      "port": 3030
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/site", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "port": 5174
    }
  ]
}
