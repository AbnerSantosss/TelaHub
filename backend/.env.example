# Banco de dados (Neon PostgreSQL em produção, SQLite local em dev)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Segurança
# Em produção o boot ABORTA se este valor faltar, tiver menos de 32 caracteres,
# ou for igual ao fallback de desenvolvimento — com o segredo do código qualquer
# pessoa forjaria um token de master. Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-em-producao

# Nº de proxies na frente do backend (Nginx + Cloudflare Tunnel). Sem isto o
# `req.ip` é sempre o do proxy e o rate limit de login/signup agrupa todos os
# visitantes num contador único. Ajuste ao seu encadeamento real.
TRUST_PROXY=2

# Servidor
PORT=3001

# URL do frontend (usada nos links de email — convite e reset de senha)
APP_URL=https://your-domain.example.com

# CORS — urls separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3030

# Admin padrão (usado por `prisma/seed-prod.js`, que roda a cada boot).
#
# Em produção (NODE_ENV=production) o seed ABORTA se faltarem — e como o compose
# encadeia os passos com `&&`, o container não sobe. É proposital: cair num
# default conhecido criaria um `master` de senha previsível sem ninguém notar.
# Mínimo de 12 caracteres. Gere com: openssl rand -base64 24
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=COLOQUE_UMA_SENHA_FORTE_AQUI
ADMIN_NAME=Administrador

# O seed NÃO reescreve a senha do admin nos boots seguintes — senão toda troca
# feita pelo painel seria desfeita no próximo restart. Para forçar a redefinição
# (ex.: perdeu o acesso), suba com esta variável em `true` e remova depois.
# ADMIN_PASSWORD_RESET=true

# Cloudflare R2 — obrigatório quando NODE_ENV=production (o backend falha no boot
# se faltar alguma dessas variáveis em produção). Em desenvolvimento, é opcional:
# se não configurado, uploads caem para disco local.
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2_ACCESS_KEY=your-access-key
# R2_SECRET_KEY=your-secret-key
# R2_BUCKET=telahub-media
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

