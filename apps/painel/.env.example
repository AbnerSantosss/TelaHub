VITE_API_URL=http://localhost:3001/api

# Endereços dos outros dois apps do produto (ADR-001: três frontends publicados
# de forma independente). Opcionais — `libs/external-urls.ts` já traz os valores
# de produção como default.
#
# Preencha em desenvolvimento se quiser que o botão de contratar plano aponte
# para a sua cópia local em vez da produção:
# VITE_SITE_URL=http://localhost:42938
# VITE_CHECKOUT_URL=http://localhost:42939

# Atalhos de entrada na tela de login. Só existem em `npm run dev`; o build de
# produção elimina o bloco inteiro. Um botão por conta preenchida.
# Admin (conta master do banco local):
# VITE_DEV_MASTER_EMAIL=
# VITE_DEV_MASTER_PASSWORD=
# Uma conta por plano, criadas por `npm run db:seed-demo-users` na API:
# VITE_DEV_PLAN_PASSWORD=Demo@123
# VITE_DEV_GRATIS_EMAIL=demo.gratis@telahub.local
# VITE_DEV_LOJA_EMAIL=demo.loja@telahub.local
# VITE_DEV_REDE_EMAIL=demo.rede@telahub.local
