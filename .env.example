# =============================================================================
# TelaHub — Variáveis de Ambiente
# =============================================================================
# COMO USAR:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores reais no arquivo .env
#   3. NUNCA commite o arquivo .env no Git (ele já está no .gitignore)
#   4. No Portainer: cole os valores em "Environment variables" ao criar a stack
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=display_user
POSTGRES_PASSWORD=COLOQUE_UMA_SENHA_FORTE_AQUI
POSTGRES_DB=display_db

# --- Backend / API ---
JWT_SECRET=GERE_UMA_CHAVE_ALEATORIA_AQUI_MINIMO_32_CARACTERES
APP_URL=https://your-domain.example.com
CORS_ORIGINS=*

# --- Admin (usado no seed de produção) ---
ADMIN_EMAIL=COLOQUE_SEU_EMAIL_ADMIN_AQUI
ADMIN_PASSWORD=COLOQUE_UMA_SENHA_FORTE_AQUI

# --- pgAdmin ---
PGADMIN_EMAIL=COLOQUE_SEU_EMAIL_PGADMIN_AQUI
PGADMIN_PASSWORD=COLOQUE_UMA_SENHA_FORTE_AQUI

