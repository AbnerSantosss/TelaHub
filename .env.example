# =============================================================================
# TelaHub — Variáveis de Ambiente
# =============================================================================
# COMO USAR:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores reais no arquivo .env
#   3. NUNCA commite o arquivo .env no Git (ele já está no .gitignore)
#   4. No Portainer: cole os valores em "Environment variables" ao criar a stack
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=display_user
POSTGRES_PASSWORD=COLOQUE_UMA_SENHA_FORTE_AQUI
POSTGRES_DB=display_db

# --- Backend / API ---
JWT_SECRET=GERE_UMA_CHAVE_ALEATORIA_AQUI_MINIMO_32_CARACTERES
APP_URL=https://your-domain.example.com
CORS_ORIGINS=*

# --- Admin (usado no seed de produção) ---
ADMIN_EMAIL=COLOQUE_SEU_EMAIL_ADMIN_AQUI
ADMIN_PASSWORD=COLOQUE_UMA_SENHA_FORTE_AQUI

# --- E-mail / SMTP (padrão de fábrica da instalação) ---
# É o provedor usado enquanto ninguém configurar outro pelo painel. O que o
# `master` salvar em Configurações de E-mail tem precedência sobre isto.
#
# SMTP_PROVIDER aceita: gmail | google-workspace | outlook | microsoft365 |
# zoho | zoho-workspace | yahoo | icloud | sendgrid | mailgun | amazon-ses |
# brevo | postmark | resend | custom
# Host, porta e criptografia saem do catálogo do provedor
# (backend/src/services/email-providers.ts); só preencha SMTP_HOST/PORT/SECURE
# com `custom` ou para sobrescrever o preset (ex.: região EU do Mailgun/SES).
SMTP_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=COLOQUE_O_EMAIL_DE_ENVIO_AQUI
SMTP_PASS=COLOQUE_A_SENHA_DE_APP_AQUI
# Remetente exibido. Em SendGrid/Resend é obrigatório e diferente do usuário,
# que é a palavra fixa `apikey` / `resend`.
SMTP_FROM_EMAIL=COLOQUE_O_EMAIL_DE_ENVIO_AQUI
SMTP_FROM_NAME=TelaHub

# --- pgAdmin ---
PGADMIN_EMAIL=COLOQUE_SEU_EMAIL_PGADMIN_AQUI
PGADMIN_PASSWORD=COLOQUE_UMA_SENHA_FORTE_AQUI


# ── Adicionados em 2026-08-29 (Fase 0 do plano comercial) ────────────────────

# Para onde vai o aviso de lead novo vindo do formulário do site.
# Sem esta variável, o aviso cai na própria caixa configurada no SMTP.
COMMERCIAL_EMAIL=

# Allowlist opcional do proxy de RSS. Vazio = qualquer host público (endereços
# de rede interna são bloqueados de qualquer forma, ver src/lib/safe-http.ts).
# Ex.: HTTP_PROXY_ALLOWED_HOSTS=g1.globo.com,feeds.bbci.co.uk
HTTP_PROXY_ALLOWED_HOSTS=

# Ajuste fino de rate limit. Só mexa se um caso legítimo esbarrar no limite —
# ex.: instalação em massa de telas num shopping esbarra em DEVICE_REGISTER.
DEVICE_REGISTER_RATE_LIMIT=100
DEVICE_TELEMETRY_RATE_LIMIT=60
PROXY_RATE_LIMIT=120
LEAD_RATE_LIMIT=10


# ── Adicionados em 2026-09-05 (execução do plano de 90 dias) ─────────────────

# --- Identificação do fornecedor (CDC art. 6º, III) ---
# Aparecem no rodapé do site, nos Termos, na Política de Privacidade e na nota
# fiscal. Sem CNPJ visível, a página não pode cobrar nem anunciar: Meta e Google
# reprovam anúncio de site que coleta dado sem identificar quem está por trás.
COMPANY_CNPJ=74.191.667/0001-55
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
# Canal do titular de dados (LGPD art. 18). Pode ser o mesmo do comercial.
PRIVACY_CONTACT_EMAIL=

# --- Medição: Google ---
# O MESMO container serve site, painel e checkout — a jornada atravessa três
# domínios e um container por app quebraria o funil em três relatórios que não
# se somam.
GTM_CONTAINER_ID=GTM-W7K6QK7Z

# --- Medição: Meta (Facebook) ---
# O Pixel é público (vai no HTML, qualquer um lê). O TOKEN não: ele autoriza
# enviar eventos em nome da conta de anúncios e NUNCA pode ir para o frontend
# nem para o Git. Fica só aqui e no Portainer.
META_PIXEL_ID=1119943063690657
META_CAPI_ACCESS_TOKEN=COLOQUE_O_TOKEN_DA_CONVERSIONS_API_AQUI
# Código de teste da Conversions API. Preencha só enquanto estiver validando no
# "Test Events" do Gerenciador de Eventos; em produção deixe VAZIO, senão os
# eventos entram como teste e não otimizam campanha nenhuma.
META_CAPI_TEST_EVENT_CODE=

# --- Gateway de pagamento ---
# simulado | asaas. `simulado` é recusado em produção (ver payment-providers.ts).
PAYMENT_PROVIDER=simulado
# Ambiente do Asaas: sandbox | production. Errar isto é cobrar de verdade em
# teste, ou testar contra dinheiro que não existe.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token que o Asaas devolve no cabeçalho do webhook. É o que prova que a
# chamada veio do gateway e não de alguém que descobriu a URL — sem ele,
# qualquer pessoa confirma o próprio pagamento com um curl.
ASAAS_WEBHOOK_TOKEN=
# Emissão de NFS-e pelo módulo do Asaas. `false` = nota manual (1º mês).
ASAAS_NFSE_ENABLED=false

# --- URL pública do site de vendas ---
# Fonte única do canonical, do Open Graph e do JSON-LD. Trocar de domínio é
# mudar esta linha e rebuildar. NUNCA voltar a chumbar telahub.com.br: aquele
# domínio é de terceiro desde 2025 e apontar o canonical para ele pede ao Google
# para indexar o site de outra empresa no lugar deste.
SITE_PUBLIC_URL=https://vendas.proxserverabner.site
