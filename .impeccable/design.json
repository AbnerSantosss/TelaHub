      "refersTo": "button-luz",
      "description": "Primário sobre faixa noite.",
      "html": "<div class=\"ds-faixa-noite\"><button class=\"ds-btn-luz\">Começar agora</button></div>",
      "css": ".ds-faixa-noite{background:var(--noite);padding:24px}.ds-btn-luz{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:14px 24px;border:none;border-radius:var(--raio-8);font-family:var(--fonte);font-weight:700;font-size:1rem;background:var(--luz);color:var(--noite);cursor:pointer;transition:background-color .16s ease,transform .16s var(--ease-saida)}.ds-btn-luz:hover{background:var(--luz-2)}.ds-btn-luz:active{transform:scale(.97)}.ds-btn-luz:focus-visible{outline:3px solid var(--luz);outline-offset:2px}"
    },
