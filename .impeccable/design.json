      "css": ".ds-btn-off{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 18px;border:1px solid var(--borda);border-radius:var(--raio-8);font-family:var(--fonte);font-weight:600;font-size:15px;background:var(--papel-3);color:var(--tinta-3);box-shadow:none;cursor:not-allowed}"
