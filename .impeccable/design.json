      "html": "<button class=\"ds-btn\">Criar conta grátis</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:14px 24px;border:none;border-radius:var(--raio-8);font-family:var(--fonte);font-weight:700;font-size:1rem;line-height:1.2;background:var(--marca);color:var(--papel);box-shadow:0 2px 4px rgba(0,0,0,.2);cursor:pointer;transition:background-color .16s ease,box-shadow .2s ease,transform .16s var(--ease-saida)}.ds-btn:hover{background:var(--marca-hover)}@media (hover:hover) and (pointer:fine){.ds-btn:hover{transform:translateY(-1px)}}.ds-btn:active{transform:scale(.97);box-shadow:0 1px 2px rgba(0,0,0,.2)}.ds-btn:focus-visible{outline:3px solid var(--marca);outline-offset:2px}"
    },
    {
