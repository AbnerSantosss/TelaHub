      "css": ".ds-aviso{display:flex;align-items:flex-start;gap:10px;padding:12px 14px;background:var(--marca-fundo);color:var(--tinta);font-family:var(--fonte);font-size:.75rem;line-height:1.6;max-width:56ch}.ds-aviso svg{flex:none;margin-top:2px;color:var(--marca)}"
    },
