      "css": ".ds-card{background:var(--papel);border:1px solid var(--borda-2);border-radius:var(--raio-16);box-shadow:var(--sombra-card);padding:16px;font-family:var(--fonte);transition:border-color .2s ease}.ds-card:hover{border-color:var(--borda-3)}.ds-card-titulo{font-size:1rem;font-weight:500;line-height:1.375;color:var(--tinta)}.ds-card-texto{margin:4px 0 0;font-size:.875rem;color:var(--tinta-3)}"
    },
