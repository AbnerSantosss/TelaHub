      "html": "<label class=\"ds-rotulo\" for=\"ds-email\">E-mail</label><input id=\"ds-email\" class=\"ds-input\" placeholder=\"voce@empresa.com.br\">",
      "css": ".ds-rotulo{display:block;margin-bottom:6px;font-family:var(--fonte);font-size:.8125rem;font-weight:600;line-height:1.3;color:var(--tinta-2)}.ds-input{width:100%;min-height:44px;padding:10px 12px;border:1px solid var(--borda-3);border-radius:var(--raio-8);background:var(--papel);color:var(--tinta);font-family:var(--fonte);font-size:16px;outline:none;transition:border-color .15s ease,box-shadow .15s ease}.ds-input::placeholder{color:var(--tinta-3)}.ds-input:hover{border-color:var(--tinta-3)}.ds-input:focus,.ds-input:focus-visible{border-color:var(--marca);box-shadow:var(--anel-marca)}"
